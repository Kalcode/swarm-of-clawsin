# Copy to .env (gitignored) and fill in what you use. Every line is optional.
# Semantic recall for the creature harness (voyageai.com); without it recall searches by keywords.
VOYAGE_API_KEY=
# For minds on Google's cloud models (a node's --model-server at generativelanguage.googleapis.com).
GOOGLE_API_KEY=
# The gaming PC's Ollama, for start-world.sh's PC="NAME:N" node and scripts/long-run.sh, e.g. http://192.168.1.50:11434/v1
PC_SERVER=
# The Cloudflare account that serves the closed page (scripts/public-closed.sh; docs/public-viewer.md).
CLOUDFLARE_ACCOUNT_ID=
